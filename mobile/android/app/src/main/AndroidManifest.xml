<?xml version="1.0" encoding="utf-8"?>
<!-- L301：最小清单——单 Activity（Compose）+ 无网络权限（骨架期 FFI 全本地，
     演示数据由 Rust 侧生成；api-gateway 接入与 INTERNET 权限归后续 TODO） -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- L512 生物识别门：androidx.biometric 的 normal 权限（安装期授予，
         无运行时弹窗），注册表 [allow] 段有对应条目 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlphaMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- L509 静态快捷方式（长按图标直达标的预选分析） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- L509 行情小卡：exported=false（官方口径，系统特权投递
             APPWIDGET_UPDATE）；无网络权限，数据只来自应用内发布 -->
        <receiver
            android:name=".AlphaQuoteWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quote_info" />
        </receiver>
    </application>
</manifest>
