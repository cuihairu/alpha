┼──────────────────────┐</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">          │                      │                      │</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">┌─────────┴───────┐    ┌─────────┴───────┐    ┌─────────┴───────┐</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">│  Real-time Feed  │    │   Data Engine   │    │    Collector    │</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">└─────────────────┘    └─────────┬───────┘    └─────────────────┘</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">                                 │</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">                    ┌─────────────┴─────────────┐</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">                    │      ClickHouse          │</span><br></span><span class="token-line" style="color:#bfc7d5"><span class="token plain">                    └───────────────────────────┘</span><br></span></code></pre><div class="buttonGroup_ht5D"><button type="button" aria-label="复制代码到剪贴板" title="复制" class="clean-btn"><span class="copyButtonIcons_ENrM" aria-hidden="true"><svg viewBox="0 0 24 24" class="copyButtonIcon_ZWMF"><path fill="currentColor" d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"></path></svg><svg viewBox="0 0 24 24" class="copyButtonSuccessIcon_fZWe"><path fill="currentColor" d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"></path></svg></span></button></div></div></div>
