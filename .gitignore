# Rust
/target/
# 包级 target（workspace 统一在根 /target/ 构建；显式传 PGO_DIR 等参数
# 会在包目录下生成中间产物——L455 实测出现过 packages/protocols/target/）
packages/*/target/
Cargo.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# WebAssembly
wasm-analyzer/pkg/
wasm-analyzer/node_modules/

# Web (build output)
web/dist/*
web/pkg/*
# React 骨架（L427）：构建产物与可选 wasm/duckdb 拷贝位（node_modules 由全局规则覆盖）
web/app/dist/
web/app/public/pkg/
web/app/public/vendor/
web/app/tsconfig.tsbuildinfo
!web/dist/.gitkeep
# 桌面端 Tauri 的 distDir（tauri.conf.json build.distDir）必须有内容才能启动窗口，
# 故兜底壳受版本控制；`npm run build` 会用真实前端覆盖这两个文件
!web/dist/index.html
!web/dist/desktop-shell.js

# Web (generated vendor bundles)
web/vendor/*
!web/vendor/.gitkeep
!web/vendor/**/.gitkeep

# Desktop
desktop/src-tauri/target/
desktop/target/
desktop/dist/

# Mobile
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/Pods/
mobile/ios/.xcode.env.local

# Tools
tools/benchmark/target/
tools/data-migration/target/

# Database
*.db
*.sqlite
*.sqlite3

# Docker
.dockerignore

# Coverage
tarpaulin-report.html
cobertura.xml

# Backup
*.bak
*.backup

# Temporary
*.tmp
*.temp
