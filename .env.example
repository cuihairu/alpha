# Alpha Finance 环境配置示例
# 复制此文件为 .env 并修改相应配置

# ===== 数据库配置 =====
# ClickHouse 数据库配置
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123
CLICKHOUSE_DATABASE=alpha_finance
CLICKHOUSE_NATIVE_URL=tcp://localhost:9000

# ===== 服务端口配置 =====
# API 网关端口
API_GATEWAY_PORT=9080
API_GATEWAY_HOST=0.0.0.0

# 实时数据推送服务端口
REAL_TIME_FEED_PORT=9081
REAL_TIME_FEED_HOST=0.0.0.0

# 数据引擎服务端口
DATA_ENGINE_PORT=9082
DATA_ENGINE_HOST=0.0.0.0

# 数据收集服务端口
COLLECTOR_PORT=9083
COLLECTOR_HOST=0.0.0.0

# Web 前端端口
WEB_PORT=8080

# ===== 安全配置 =====
# JWT 密钥（生产环境请使用强密码）
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# API 密钥（生产环境请使用强密码）
API_SECRET_KEY=your-api-secret-key-change-this-in-production

# 会话密钥
SESSION_SECRET=your-session-secret-change-this-in-production

# ===== 日志配置 =====
# 日志级别: trace, debug, info, warn, error
RUST_LOG=info

# 日志文件路径
LOG_DIR=/var/log/alpha

# ===== 性能配置 =====
# 数据库连接池大小
DB_POOL_SIZE=10

# 请求超时时间（秒）
REQUEST_TIMEOUT=30

# WebSocket 心跳间隔（秒）
WEBSOCKET_HEARTBEAT=30

# ===== 缓存配置 =====
# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 监控配置 =====
# Prometheus 指标端口
METRICS_PORT=9090

# 健康检查间隔（秒）
HEALTH_CHECK_INTERVAL=60

# ===== 外部服务配置 =====
# 数据源 API 配置
MARKET_DATA_API_URL=https://api.example.com
MARKET_DATA_API_KEY=your-api-key-here

# WebSocket 数据源
WEBSOCKET_DATA_URL=wss://data.example.com/ws

# ===== 开发配置 =====
# 开发模式
DEBUG=false

# 热重载
HOT_RELOAD=false

# CORS 配置
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# ===== 生产环境配置 =====
# 生产环境域名
PRODUCTION_DOMAIN=your-domain.com

# SSL 证书路径
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# 备份配置
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ===== 高级配置 =====
# 最大并发连接数
MAX_CONNECTIONS=1000

# 请求速率限制（每分钟）
RATE_LIMIT=1000

# 文件上传大小限制（MB）
MAX_UPLOAD_SIZE=10

# 数据压缩
ENABLE_COMPRESSION=true

# 缓存过期时间（秒）
CACHE_EXPIRE=3600

# ===== 特性开关 =====
# 启用实时数据
ENABLE_REAL_TIME_DATA=true

# 启用技术指标计算
ENABLE_TECHNICAL_INDICATORS=true

# 启用数据导出
ENABLE_DATA_EXPORT=true

# 启用用户认证
ENABLE_AUTHENTICATION=true

# ===== Docker 配置 =====
# Docker 网络
DOCKER_NETWORK=alpha-network

# 容器重启策略
RESTART_POLICY=unless-stopped

# 资源限制
MEMORY_LIMIT=2g
CPU_LIMIT=2