# Alpha 环境配置示例
#
# 本文件的定位：docker compose 的变量替换源。compose 启动时自动加载根目录 .env，
# 只对 docker-compose.yml 中 `${VAR:-default}` 形式的引用生效（见下）。
# 服务进程级配置面（ALPHA_* env、CLI 参数）不在本文件——各服务消费哪些变量
# 见 docs/deployment-runbook.md §4「服务配置面」。
#
# 用法：cp .env.example .env，按需修改后 docker compose up -d。全部默认值即可用。

# ===== 告警通知渠道（alertmanager-webhook 消费，缺哪个跳过哪个）=====
# 钉钉机器人 Webhook URL
DINGTALK_WEBHOOK_URL=
# 企业微信机器人 Webhook URL
WECHAT_WEBHOOK_URL=
# Slack Webhook URL
SLACK_WEBHOOK_URL=
# PagerDuty Events API v2 集成键
PAGERDUTY_INTEGRATION_KEY=

# ===== collector 任务模板（容器内模板采集路径）=====
# 默认挂载仓内示例 config/collector.tasks.yaml 并指向它；
# 覆写为宿主机其他路径或置空（ALPHA_COLLECTOR_TASKS=）关闭装载。
ALPHA_COLLECTOR_TASKS=/app/config/collector.tasks.yaml

# ===== data-engine 落库开关（config-rs：服务段双下划线、键内单下划线）=====
# 时序镜像落库开关与 TimescaleDB 连接串（可选镜像，默认启用并指向 timescaledb 服务）
ALPHA__STORAGE__PERSISTENCE_ENABLED=true
ALPHA__STORAGE__TIMESCALE_URL=postgres://postgres:postgres@timescaledb:5432/alpha_finance

# ===== ClickHouse 连接参数（仅 scripts/clickhouse-init.sh 手动初始化时从 shell 读取）=====
# compose 路径下 schema 由镜像 initdb 挂载 config/clickhouse-schema.sql 自动初始化，
# 无需手动执行；裸机路径 scripts/deploy-ubuntu.sh 会生成 .env 并加载后调用该脚本。
# 与 docker-compose.yml 内 clickhouse 服务的账密保持一致（admin/admin123，仅限内网演示）。
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin123
CLICKHOUSE_DATABASE=alpha_finance
